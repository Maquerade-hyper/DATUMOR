APP_ENV=development
APP_NAME=DATUMOR
APP_VERSION=0.1.0
APP_SECRET_KEY=replace-with-secure-secret

POSTGRES_DB=datumor
POSTGRES_USER=datumor
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://datumor:change-me-local-only@127.0.0.1:5432/datumor

REDIS_PASSWORD=replace-me
REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379/0

MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_BUCKET=datumor

# Local S3-compatible storage credentials (example placeholders)
DATUMOR_S3_ACCESS_KEY=replace-with-local-s3-access-key
DATUMOR_S3_SECRET_KEY=replace-with-a-long-random-s3-secret

# Application runtime settings
DATUMOR_DB_USER=datumor
DATUMOR_DB_PASSWORD=change-me-local-only
DATUMOR_DB_NAME=datumor
DATUMOR_DB_HOST=127.0.0.1
DATUMOR_DB_PORT=5432
DATUMOR_REDIS_URL=redis://127.0.0.1:6379/1
DATUMOR_STAGING_DIR=data/staging
